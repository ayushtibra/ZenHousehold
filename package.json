{
  "name": "zenhousehold",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && tsc -p functions",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply zenhousehold --local",
    "db:migrate:remote": "wrangler d1 migrations apply zenhousehold --remote",
    "deploy": "npm run build && wrangler pages deploy --branch main --commit-dirty=true"
  },
  "dependencies": {
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8",
    "wrangler": "^4.40.0"
  }
}
